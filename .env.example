# Port aplikasi HTTP
APP_PORT=8080

# Koneksi PostgreSQL (Format: postgres://user:password@host:port/dbname?sslmode=disable)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_finance?sslmode=disable

# Rahasia tanda tangan JWT (gunakan string acak dan aman)
JWT_SECRET=hotel-accounting-super-secret-jwt-key-change-in-production

# Pengaturan Notifikasi Pengingat (Reminder Checkout) - Opsional (Default: Mode Simulasi/Tautan Langsung)
# SMTP Email:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp Gateway API (Opsional):
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
